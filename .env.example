# Variables para el stack central completo via docker-compose.yml (raiz del
# repo). Copiar a ".env" en esta misma carpeta y completar con valores de
# PRODUCCION (nunca reutilizar los de desarrollo de backend/.env).
#
# Uso: docker compose up -d --build

# --- PostgreSQL ---
POSTGRES_USER=nocsoc_prod
POSTGRES_PASSWORD=replace-with-a-strong-unique-password
POSTGRES_DB=nocsoc

# --- Backend ---
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
# Dominio real del frontend, con https:// una vez que tengas TLS
CORS_ORIGIN=https://noc.tudominio.com
AGENT_ENROLLMENT_SECRET=replace-with-a-long-random-secret

# Notificaciones externas (todas opcionales)
NOTIFY_MIN_SEVERITY=HIGH
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noc@tudominio.com
ALERT_EMAIL_TO=
SLACK_WEBHOOK_URL=
WEBHOOK_URL=

# --- Frontend ---
# Se incrustan en el bundle al hacer build (docker compose build), no se
# pueden cambiar despues sin reconstruir la imagen.
NEXT_PUBLIC_API_URL=https://noc.tudominio.com
NEXT_PUBLIC_WS_URL=wss://noc.tudominio.com/ws
