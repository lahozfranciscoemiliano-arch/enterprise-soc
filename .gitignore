# Dependencies
node_modules/
__pycache__/
*.pyc

# Environment secrets (only *.example / *.local.example are tracked)
.env
.env.local
!.env.example
!.env.local.example

# Build output
.next/
dist/
build/
*.spec

# Logs
*.log
agent.log

# Manual timestamped backups (not real history, may contain copied .env secrets)
_backups/

# Binario compilado del agente publicado para descarga (se sube al VPS a mano
# o via CI, no se versiona en git)
backend/downloads/*.exe

# Reportes ejecutivos generados en runtime (ver src/services/reports.js) --
# persisten en el volumen Docker "report_files", no en git.
backend/reports/*.pdf

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
