DATABASE_URL="postgresql://user:password@localhost:5432/nocsoc?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="http://localhost:3001"
PORT=3000
# En produccion DEBE ser "production": la cookie de sesion solo se marca
# Secure (HTTPS obligatorio) cuando NODE_ENV=production. En development se
# omite ese flag a proposito porque el dashboard corre sobre http local.
NODE_ENV=development
# Secreto compartido para que el instalador del agente pueda auto-registrar
# servidores nuevos via POST /api/servers/enroll. Si se omite, ese endpoint
# queda deshabilitado (503) y hay que crear servidores manualmente.
AGENT_ENROLLMENT_SECRET="replace-with-a-long-random-secret"

# ---------------------------------------------------------------------------
# A partir de aca, TODO lo siguiente es editable en caliente desde
# Admin -> Configuracion (sin reiniciar el backend) y estas variables solo
# sirven de valor por defecto inicial / fallback si no se toco nada ahi.
# La excepcion es FORTI_SYSLOG_*: ese listener se abre una sola vez al
# arrancar, asi que un cambio ahi si requiere reiniciar el backend.
# ---------------------------------------------------------------------------

# Notificaciones externas de alertas (todas opcionales; se omite el canal si
# no esta configurado). Solo se notifican alertas con severidad >= NOTIFY_MIN_SEVERITY.
NOTIFY_MIN_SEVERITY="HIGH"

# Email (SMTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noc@tudominio.com"
ALERT_EMAIL_TO=""

# Slack (Incoming Webhook: https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=""

# Webhook generico (Teams, Discord, PagerDuty, tu propio sistema, etc.)
WEBHOOK_URL=""

# Asistente (Gemini) - requiere una API key de aistudio.google.com (tiene
# nivel gratuito con limite de requests/minuto; para uso mas intensivo hay
# que asociar un proyecto de Google Cloud con facturacion habilitada)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Receptor de syslog UDP para dispositivos Fortinet (alternativa a la
# ingesta por API). Ver Admin -> Configuracion -> Fortinet.
FORTI_SYSLOG_ENABLED="false"
FORTI_SYSLOG_PORT=5514
