DATABASE_URL="postgresql://user:password@localhost:5432/nocsoc?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="http://localhost:3001"
PORT=3000
NODE_ENV=development
# Secreto compartido para que el instalador del agente pueda auto-registrar
# servidores nuevos via POST /api/servers/enroll. Si se omite, ese endpoint
# queda deshabilitado (503) y hay que crear servidores manualmente.
AGENT_ENROLLMENT_SECRET="replace-with-a-long-random-secret"
