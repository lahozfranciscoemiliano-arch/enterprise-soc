DATABASE_URL="postgresql://user:password@localhost:5432/nocsoc?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="http://localhost:3001"
PORT=3000
# En produccion DEBE ser "production": la cookie de sesion solo se marca
# Secure (HTTPS obligatorio) cuando NODE_ENV=production. En development se
# omite ese flag a proposito porque el dashboard corre sobre http local.
NODE_ENV=development
# Secreto compartido para que el instalador del agente pueda auto-registrar
# servidores nuevos via POST /api/servers/enroll. Si se omite, ese endpoint
# queda deshabilitado (503) y hay que crear servidores manualmente.
AGENT_ENROLLMENT_SECRET="replace-with-a-long-random-secret"

# Notificaciones externas de alertas (todas opcionales; se omite el canal si
# no esta configurado). Solo se notifican alertas con severidad >= NOTIFY_MIN_SEVERITY.
NOTIFY_MIN_SEVERITY="HIGH"

# Email (SMTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noc@tudominio.com"
ALERT_EMAIL_TO=""

# Slack (Incoming Webhook: https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=""

# Webhook generico (Teams, Discord, PagerDuty, tu propio sistema, etc.)
WEBHOOK_URL=""
