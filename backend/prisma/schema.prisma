generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum ServerStatus {
  ONLINE
  OFFLINE
  DEGRADED
}

enum EventType {
  CPU_THRESHOLD
  MEMORY_THRESHOLD
  DISK_THRESHOLD
  LOGIN_FAILURE
  UNAUTHORIZED_ACCESS
  MALWARE_DETECTED
  PORT_SCAN
  BACKUP_FAILED
  BACKUP_WARNING
  CUSTOM
}

enum BackupResult {
  SUCCESS
  WARNING
  FAILED
  NOT_CONFIGURED
  UNKNOWN
}

enum EventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EventStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model User {
  id                   String          @id @default(uuid())
  email                String          @unique
  passwordHash         String
  name                 String
  role                 Role            @default(VIEWER)
  twoFactorEnabled     Boolean         @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[]        @default([])
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  acknowledgedEvents   SecurityEvent[] @relation("AcknowledgedBy")
  auditLogs            AuditLog[]
  sessions             Session[]

  @@map("users")
}

// Sesiones activas emitidas en el login. El JWT por si solo es stateless
// (no se puede invalidar antes de que expire); esta tabla es lo que permite
// una revocacion real: logout, "cerrar todas mis sesiones", o un admin
// forzando el cierre de sesion de otro usuario (cuenta comprometida, baja).
model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti       String    @unique
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Server {
  id         String          @id @default(uuid())
  name       String          @unique
  hostname   String
  ipAddress  String
  apiKeyHash String
  status     ServerStatus    @default(OFFLINE)
  lastSeenAt DateTime?

  // Umbrales de alerta propios de este servidor; si son null se usan los
  // valores globales por defecto definidos en alertEngine.js.
  cpuThresholdHigh    Float?
  cpuThresholdMedium  Float?
  memThresholdHigh    Float?
  memThresholdMedium  Float?
  diskThresholdHigh   Float?
  diskThresholdMedium Float?

  // Mientras maintenanceUntil este en el futuro, la telemetria/backups de
  // este servidor se siguen guardando normalmente pero no generan alertas.
  maintenanceUntil DateTime?

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  telemetry Telemetry[]
  events    SecurityEvent[]
  backups   BackupStatus[]

  @@map("servers")
}

model Telemetry {
  id           String   @id @default(uuid())
  serverId     String
  server       Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  cpuUsage     Float
  memoryUsage  Float
  diskUsage    Float
  networkIn    Float?
  networkOut   Float?
  processCount Int?
  metadata     Json?
  recordedAt   DateTime @default(now())

  @@index([serverId, recordedAt])
  @@map("telemetry")
}

model BackupStatus {
  id           String       @id @default(uuid())
  serverId     String
  server       Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  result       BackupResult
  method       String
  lastBackupAt DateTime?
  targetPath   String?
  sizeBytes    Float?
  vssServiceOk Boolean      @default(false)
  detail       String?
  metadata     Json?
  recordedAt   DateTime     @default(now())

  @@index([serverId, recordedAt])
  @@map("backup_status")
}

model SecurityEvent {
  id               String        @id @default(uuid())
  serverId         String
  server           Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  type             EventType
  severity         EventSeverity
  status           EventStatus   @default(OPEN)
  description      String
  sourceIp         String?
  metadata         Json?
  acknowledgedById String?
  acknowledgedBy   User?         @relation("AcknowledgedBy", fields: [acknowledgedById], references: [id])
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?

  @@index([serverId, createdAt])
  @@index([severity, status])
  @@map("security_events")
}
