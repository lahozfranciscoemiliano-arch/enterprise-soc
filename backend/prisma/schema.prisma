generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum ServerStatus {
  ONLINE
  OFFLINE
  DEGRADED
}

enum EventType {
  CPU_THRESHOLD
  MEMORY_THRESHOLD
  DISK_THRESHOLD
  LOGIN_FAILURE
  UNAUTHORIZED_ACCESS
  MALWARE_DETECTED
  PORT_SCAN
  BACKUP_FAILED
  BACKUP_WARNING
  CUSTOM
  // Watchdog (services/heartbeat.js): el agente dejo de reportar telemetria.
  AGENT_OFFLINE
  // Deteccion de anomalias estadistica (services/anomalyDetection.js): un
  // valor se sale del patron normal de ESE servidor a ESA hora, aunque no
  // cruce ningun umbral fijo.
  ANOMALY_DETECTED
  // Synthetic monitoring (services/syntheticMonitor.js): no se pudo
  // establecer una conexion TCP al puerto configurado del servidor.
  NETWORK_UNREACHABLE
  // Mantenimiento preventivo (services/preventiveChecks.js y diskForecast.js),
  // a partir de los datos extendidos que manda el agente >= 1.3.0.
  DISK_FORECAST
  DISK_FAILURE_PREDICTED
  SERVICE_DOWN
  REBOOT_PENDING
  PATCHES_OUTDATED
  // Conectividad del sitio (medida por el agente desde adentro de la red).
  NETWORK_DEGRADED
  ISP_FAILOVER
  INTERNET_OUTAGE
  // Inventario de red (services/inventory.js), reportado por el servidor
  // con AD/DHCP.
  DHCP_SCOPE_EXHAUSTED
  IP_CONFLICT
  PRINTER_ISSUE
  AD_ACCOUNT_LOCKOUT
  PRIVILEGED_GROUP_CHANGE
  // Monitoreo de aplicaciones de negocio (services/appMonitor.js). Alertas
  // silenciosas: se ven en el NOC pero no notifican.
  APP_SERVICE_DOWN
  APP_PERFORMANCE
  NETWORK_MICROCUTS
  // Guardian de red (services/netGuard.js): DHCP no autorizado, gateway
  // suplantado/IP duplicada, equipo nunca visto en la red.
  ROGUE_DHCP
  GATEWAY_CONFLICT
  UNKNOWN_DEVICE
  // Prueba de velocidad programada por debajo de lo contratado.
  SPEEDTEST_LOW
}

enum BackupResult {
  SUCCESS
  // Backup corriendo en este momento (no se evalua hasta que termine).
  RUNNING
  WARNING
  FAILED
  NOT_CONFIGURED
  UNKNOWN
}

enum EventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EventStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum FortiIngestMethod {
  API
  SYSLOG
}

enum FortiEventType {
  VPN_LOGIN
  VPN_LOGOUT
  ADMIN_LOGIN
  CONFIG_CHANGE
  IPS_ATTACK
  VIRUS_DETECTED
  INTERFACE_DOWN
  HA_FAILOVER
  TRAFFIC_ANOMALY
  FIREWALL_DENY
  OTHER
}

enum RemoteSessionStatus {
  PENDING
  ACTIVE
  CLOSED
  EXPIRED
  FAILED
}

model User {
  id                   String          @id @default(uuid())
  email                String          @unique
  passwordHash         String
  name                 String
  role                 Role            @default(VIEWER)
  twoFactorEnabled     Boolean         @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[]        @default([])
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  acknowledgedEvents   SecurityEvent[] @relation("AcknowledgedBy")
  auditLogs            AuditLog[]
  sessions             Session[]
  remoteSessions       RemoteSession[]
  assistantLogs        AssistantLog[]
  playbooksUpdated     Playbook[]
  // PIN de 6 digitos (hash bcrypt) para aprobar acciones sensibles:
  // remediaciones y cambios de estado de tickets. Bloqueo tras 5 fallos.
  pinHash              String?
  pinFailedCount       Int             @default(0)
  pinLockedUntil       DateTime?
  // Palabra/codigo que el usuario elige y que aparece en cada correo del NOC
  // que recibe: si un mail no lo trae, no lo mando el NOC (phishing).
  antiPhishingCode     String?

  @@map("users")
}

// Configuracion editable en caliente desde Admin -> Configuracion (SMTP,
// Slack, umbrales por defecto, secretos de integraciones, etc.) sin tener
// que tocar variables de entorno ni reiniciar el contenedor. Los valores
// sensibles (contraseñas, tokens, API keys) se guardan igual que cualquier
// otro pero nunca se devuelven en texto plano por la API (ver settings.js).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model FortiDevice {
  id         String            @id @default(uuid())
  name       String            @unique
  host       String
  apiKeyHash String
  method     FortiIngestMethod @default(API)
  lastSeenAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  events     FortiEvent[]

  @@map("forti_devices")
}

model FortiEvent {
  id          String         @id @default(uuid())
  deviceId    String
  device      FortiDevice    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type        FortiEventType
  severity    EventSeverity
  description String
  sourceIp    String?
  destIp      String?
  raw         Json?
  createdAt   DateTime       @default(now())

  @@index([deviceId, createdAt])
  @@index([severity, createdAt])
  @@map("forti_events")
}

// Sesion de acceso remoto (tunel inverso RDP/VNC/lo que este escuchando en
// targetPort). El agente nunca abre puertos entrantes: se conecta el mismo
// hacia el backend cuando se le pide, y el backend solo re-envia bytes en
// crudo entre esa conexion y la del operador (ver services/remoteBroker.js).
model RemoteSession {
  id         String              @id @default(uuid())
  serverId   String
  server     Server              @relation(fields: [serverId], references: [id], onDelete: Cascade)
  // Nullable + SetNull (no Cascade): quien pidio un acceso remoto a un
  // servidor es informacion de auditoria sensible -- si esa cuenta se borra
  // despues, el registro de que existio esa sesion tiene que sobrevivir,
  // igual que en AuditLog.
  userId     String?
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  targetPort Int                 @default(3389)
  status     RemoteSessionStatus @default(PENDING)
  tokenHash  String
  createdAt  DateTime            @default(now())
  startedAt  DateTime?
  endedAt    DateTime?
  expiresAt  DateTime

  @@index([serverId, createdAt])
  @@map("remote_sessions")
}

// Log de auditoria de lo consultado al asistente (Claude) -- no es un
// historial de conversacion completo, es rastreo de uso/costos y para poder
// revisar despues que se le pregunto sobre datos de la empresa.
model AssistantLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    String
  response  String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("assistant_logs")
}

// Sesiones activas emitidas en el login. El JWT por si solo es stateless
// (no se puede invalidar antes de que expire); esta tabla es lo que permite
// una revocacion real: logout, "cerrar todas mis sesiones", o un admin
// forzando el cierre de sesion de otro usuario (cuenta comprometida, baja).
model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti       String    @unique
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Server {
  id         String          @id @default(uuid())
  name       String          @unique
  hostname   String
  ipAddress  String
  apiKeyHash String
  status     ServerStatus    @default(OFFLINE)
  lastSeenAt DateTime?
  agentVersion String?

  // Etiquetas libres para agrupar servidores (sucursal, ambiente, rol, etc.)
  tags String[] @default([])

  // Umbrales de alerta propios de este servidor; si son null se usan los
  // valores globales por defecto definidos en alertEngine.js.
  cpuThresholdHigh    Float?
  cpuThresholdMedium  Float?
  memThresholdHigh    Float?
  memThresholdMedium  Float?
  diskThresholdHigh   Float?
  diskThresholdMedium Float?

  // Mientras maintenanceUntil este en el futuro, la telemetria/backups de
  // este servidor se siguen guardando normalmente pero no generan alertas.
  maintenanceUntil DateTime?

  // Ubicacion real de la sucursal (Mapa, Admin -> Servidores -> Configurar).
  // Null hasta que un ADMIN la cargue a mano -- no se adivinan coordenadas.
  latitude  Float?
  longitude Float?

  // Mini-CMDB: datos operativos del sitio que hoy solo viven "en la cabeza"
  // de alguien. Todo opcional y de solo lectura para el motor de alertas.
  ispPrimaryName      String?
  ispPrimaryContact   String?
  ispSecondaryName    String?
  ispSecondaryContact String?
  siteContactName     String?
  siteContactPhone    String?
  // Roles detectados por el monitoreo de aplicaciones: servidor de archivos,
  // controlador de dominio y sus carpetas compartidas.
  appRoles            Json?
  hasFortinet         Boolean?
  siteNotes           String?
  // Parque de servidores: ficha cargada a mano (marca, modelo, garantia,
  // ubicacion, rol, notas...). Lo que detecta el agente
  // (diagnostics.hardware) se usa como valor por defecto. La foto propia
  // vive en server_photos (no se carga con cada consulta de servidores).
  assetInfo           Json?
  // IP publica de salida de cada enlace, para saber por cual esta saliendo
  // el sitio (el agente reporta la IP publica actual en publicIp).
  ispPrimaryPublicIp   String?
  ispSecondaryPublicIp String?
  publicIp             String?
  // Velocidad contratada del enlace principal (para comparar la prueba de
  // velocidad programada).
  contractedDownMbps   Float?
  contractedUpMbps     Float?

  // Ultimo diagnostico preventivo y ultimo estado de red que mando el agente
  // (>= 1.3.0; ver services/preventiveChecks.js). Se guarda solo el ultimo:
  // la historia de CPU/RAM/disco/latencia ya vive en telemetry.
  diagnostics   Json?
  diagnosticsAt DateTime?
  network       Json?
  networkAt     DateTime?
  // Ultimo inventario de red recibido de este servidor (si tiene los roles
  // de AD/DHCP): roles, duracion, errores de cada seccion.
  inventoryAt      DateTime?
  inventorySummary Json?

  // Synthetic monitoring (services/syntheticMonitor.js): puerto TCP a
  // chequear activamente cada pocos minutos. Null = chequeo desactivado para
  // este servidor (opt-in: no todos los sitios van a tener ese puerto
  // alcanzable desde el VPS, y un check ruidoso genera mas desconfianza que
  // valor).
  syntheticCheckPort Int?

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  telemetry Telemetry[]
  events    SecurityEvent[]
  backups   BackupStatus[]
  remoteSessions RemoteSession[]

  @@map("servers")
}

model Telemetry {
  id           String   @id @default(uuid())
  serverId     String
  server       Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  cpuUsage     Float
  memoryUsage  Float
  diskUsage    Float
  networkIn    Float?
  networkOut   Float?
  processCount Int?
  metadata     Json?
  recordedAt   DateTime @default(now())

  @@index([serverId, recordedAt])
  @@index([recordedAt])
  @@map("telemetry")
}

model BackupStatus {
  id           String       @id @default(uuid())
  serverId     String
  server       Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  result       BackupResult
  method       String
  lastBackupAt DateTime?
  targetPath   String?
  sizeBytes    Float?
  vssServiceOk Boolean      @default(false)
  detail       String?
  metadata     Json?
  recordedAt   DateTime     @default(now())

  @@index([serverId, recordedAt])
  @@map("backup_status")
}

// Playbook de resolucion por tipo de evento (clave = valor del enum EventType
// o FortiEventType, ej. "BACKUP_FAILED", "IPS_ATTACK" -- ninguno de los dos
// enums se solapa, asi que una sola tabla les sirve a ambos). Contenido en
// markdown, editable desde Admin -> Playbooks; se muestra junto a cada alerta
// de ese tipo para estandarizar como se resuelve sin depender de que alguien
// se acuerde el procedimiento.
model Playbook {
  key         String   @id
  title       String
  content     String
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("playbooks")
}

model SecurityEvent {
  id               String        @id @default(uuid())
  serverId         String
  server           Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  type             EventType
  severity         EventSeverity
  status           EventStatus   @default(OPEN)
  description      String
  sourceIp         String?
  metadata         Json?
  // Triage generado por Claude (services/claude.js: triageEvent) -- causa
  // probable + accion sugerida, usando el playbook del tipo como contexto.
  // Null si el asistente no esta configurado o la llamada fallo; nunca
  // bloquea la creacion del evento (se completa async despues).
  aiTriage         String?
  // Deduplicacion (services/eventPipeline.js): una misma condicion (mismo
  // servidor + dedupKey) que sigue activa actualiza la alerta abierta en vez
  // de crear otra -- occurrences cuenta las repeticiones y lastSeenAt la
  // ultima. autoResolved = la cerro el sistema al normalizarse la condicion.
  dedupKey         String?
  occurrences      Int           @default(1)
  lastSeenAt       DateTime      @default(now())
  autoResolved     Boolean       @default(false)
  // Silenciada hasta esta fecha: sigue visible y se actualiza, pero no
  // vuelve a notificar (ni si empeora) hasta entonces.
  snoozedUntil     DateTime?
  // Alerta silenciosa: visible en el NOC, nunca notifica (email/Telegram...).
  silent           Boolean       @default(false)
  acknowledgedById String?
  acknowledgedBy   User?         @relation("AcknowledgedBy", fields: [acknowledgedById], references: [id])
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?

  @@index([serverId, createdAt])
  @@index([severity, status])
  @@index([serverId, dedupKey, status])
  @@index([status, createdAt])
  @@map("security_events")
}

// Dispositivos UniFi (APs, switches, gateways) sincronizados desde la API de
// UniFi (services/unifi.js): Site Manager en la nube (api.ui.com) o la API de
// integracion de una controladora local. id = MAC del dispositivo.
model UnifiDevice {
  id               String    @id
  name             String
  model            String?
  deviceType       String    @default("other") // ap | switch | gateway | other
  ipAddress        String?
  status           String    // online | offline | otro valor que reporte UniFi
  siteName         String?
  firmwareVersion  String?
  firmwareStatus   String?
  startupTime      DateTime?
  lastSeenOnlineAt DateTime?
  clients          Int?
  uptimeSeconds    Int?
  // Consola/host de UniFi al que pertenece (Site Manager) o sitio (API local).
  hostName         String?
  // Sitio al que pertenece (UnifiSite.id) y datos extra leidos del
  // controlador local: radios/canales, satisfaccion, CPU/RAM, uplink, puertos.
  siteId           String?
  source           String?   // cloud | local | agent
  details          Json?
  // Ya se aviso que esta caido (se avisa una vez por caida, no en cada sondeo).
  notifiedOffline  Boolean   @default(false)
  statusChangedAt  DateTime  @default(now())
  lastSyncAt       DateTime  @default(now())

  @@index([siteId])
  @@map("unifi_devices")
}

// ---------------------------------------------------------------------------
// Inventario de red (ver services/inventory.js). Lo alimenta el agente del
// servidor con AD/DHCP (BSFS2) cada ~5 minutos.
// ---------------------------------------------------------------------------

// Ambito DHCP con su mapa de IPs ya calculado (libre / concedida /
// reservada / excluida / fija en uso) -- una fila por ambito.
model DhcpScope {
  id           String   @id // scopeId, ej. 192.168.109.0
  name         String?
  mask         String
  startRange   String
  endRange     String
  state        String?
  leaseHours   Float?
  inUse        Int      @default(0)
  free         Int      @default(0)
  reserved     Int      @default(0)
  percentInUse Float    @default(0)
  addresses    Json     // [{ip, status, host, mac, user, since}]
  // Gateway de la red (opcion 3 del DHCP o el que informa el agente) y
  // origen: dhcp (ambito del servidor DHCP) | static (subred fija
  // configurada) | segment (red local barrida por el agente de esa sede).
  gateway      String?
  source       String?
  serverId     String?
  updatedAt    DateTime @updatedAt

  @@map("dhcp_scopes")
}

// PC o laptop (equipo del dominio y/o cliente DHCP).
model Endpoint {
  id               String    @id @default(uuid())
  hostname         String    @unique // nombre corto en mayusculas
  dnsName          String?
  os               String?
  osVersion        String?
  enabled          Boolean?
  description      String?
  ou               String?
  inAd             Boolean   @default(false)
  adLastLogonAt    DateTime?
  createdInAdAt    DateTime?
  ipAddress        String?
  macAddress       String?
  online           Boolean   @default(false)
  lastSeenOnlineAt DateTime?
  statusChangedAt  DateTime  @default(now())
  lastUser         String?
  lastUserAt       DateTime?
  firstSeenAt      DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([ipAddress])
  @@map("endpoints")
}

model Printer {
  id               String    @id // IP
  // MAC de la placa de red: identifica la impresora aunque cambie de IP
  // (se borra la entrada vieja en vez de quedar duplicada).
  macAddress       String?
  name             String?
  model            String?
  serial           String?
  location         String?
  status           String?   // idle | printing | warmup | other | unknown
  deviceStatus     String?   // running | warning | down | ...
  errors           String[]  @default([])
  supplies         Json?
  pageCount        Int?
  queues           Json?
  snmp             Boolean   @default(true)
  online           Boolean   @default(false)
  lastSeenOnlineAt DateTime?
  statusChangedAt  DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("printers")
}

// Usuario del Active Directory (foto del ultimo inventario).
model DirectoryUser {
  sam               String    @id
  displayName       String?
  department        String?
  title             String?
  email             String?
  enabled           Boolean   @default(true)
  lockedOut         Boolean   @default(false)
  neverExpires      Boolean   @default(false)
  passwordLastSet   DateTime?
  passwordExpiresAt DateTime?
  lastLogonAt       DateTime?
  updatedAt         DateTime  @updatedAt

  @@map("directory_users")
}

// Inicio de sesion de un usuario en un equipo (evento 4768 del DC).
model LogonEvent {
  id        String   @id @default(uuid())
  username  String
  ipAddress String
  hostname  String?
  // logon = inicio de sesion (4768) | activity = sesion en uso (4770/4624)
  kind      String   @default("logon")
  at        DateTime

  @@unique([username, ipAddress, at])
  @@index([at])
  @@index([hostname, at])
  @@map("logon_events")
}

// Auditoria del directorio: bloqueos, altas/bajas, cambios de grupos...
model DirectoryEvent {
  id         String   @id @default(uuid())
  eventId    Int
  kind       String
  target     String?
  actor      String?
  group      String?
  callerHost String?
  at         DateTime

  @@unique([eventId, target, at])
  @@index([at])
  @@map("directory_events")
}

// ---------------------------------------------------------------------------
// Monitores de servicios (services/serviceMonitor.js): chequeos HTTP/TCP/TLS
// desde la VPS contra sistemas propios y de terceros.
// ---------------------------------------------------------------------------
model ServiceCheck {
  id                  String    @id @default(uuid())
  name                String
  type                String    // http | tcp
  target              String    // URL (http) o host:puerto (tcp)
  intervalSeconds     Int       @default(60)
  timeoutMs           Int       @default(8000)
  expectedStatus      Int?      // http: vacio = cualquier 2xx/3xx
  keyword             String?   // http: texto que debe aparecer en la respuesta
  enabled             Boolean   @default(true)
  status              String    @default("unknown") // up | down | unknown
  lastLatencyMs       Int?
  lastCheckedAt       DateTime?
  lastChangeAt        DateTime?
  lastError           String?
  consecutiveFailures Int       @default(0)
  certExpiresAt       DateTime?
  certWarnedDays      Int?
  createdAt           DateTime  @default(now())
  results             ServiceCheckResult[]

  @@map("service_checks")
}

model ServiceCheckResult {
  id        String       @id @default(uuid())
  checkId   String
  check     ServiceCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  at        DateTime     @default(now())
  up        Boolean
  latencyMs Int?

  @@index([checkId, at])
  @@map("service_check_results")
}

// Resumen por sitio de UniFi Site Manager (/v1/hosts + /v1/sites). Es lo que
// la API en la nube da para controladores "Network Server" autoalojados, que
// no exponen la lista de equipos individuales.
model UnifiSite {
  id                String    @id // siteId
  hostId            String
  hostName          String
  hostType          String?
  siteName          String?
  hostOnline        Boolean?
  version           String?
  updateAvailable   Boolean?
  totalDevices      Int       @default(0)
  offlineDevices    Int       @default(0)
  wifiDevices       Int       @default(0)
  offlineWifi       Int       @default(0)
  wiredDevices      Int       @default(0)
  offlineWired      Int       @default(0)
  gatewayDevices    Int       @default(0)
  offlineGateways   Int       @default(0)
  wifiClients       Int       @default(0)
  wiredClients      Int       @default(0)
  guestClients      Int       @default(0)
  pendingUpdates    Int       @default(0)
  criticalAlerts    Int       @default(0)
  ispName           String?
  wanUptime         Float?
  txRetry           Float?
  devicesDownSince  DateTime?
  notifiedDown      Int       @default(0)
  hostOfflineSince  DateTime?
  notifiedHostDown  Boolean   @default(false)
  lastSyncAt        DateTime  @default(now())
  // Nombre interno del sitio en el controlador ("default") e IPs LAN del
  // controlador que informa la nube: con eso el agente de la sucursal
  // consulta el controlador en la red local y trae el detalle completo.
  siteKey           String?
  lanIps            String[]  @default([])
  // Detalle local (agente >= 1.8.0): quien lo leyo, cuando, salud por
  // subsistema (WAN/LAN/WLAN) y el ultimo error de conexion/login.
  localSource       String?
  localAt           DateTime?
  localError        String?
  controllerUrl     String?
  health            Json?
  // Clientes conectados (MAC, IP, switch/puerto o AP): ubicar un equipo.
  clients           Json?

  @@map("unifi_sites")
}

// ---------------------------------------------------------------------------
// Aplicaciones de negocio (Monark, ALOHA) y micro-cortes de carpetas
// compartidas / Active Directory (services/appMonitor.js, agente >= 1.11.0).
// ---------------------------------------------------------------------------
model AppInstance {
  id         String   @id @default(uuid())
  serverId   String
  appKey     String   // MONARK | ALOHA
  label      String
  status     String   // ok | degraded | down
  statusInfo String?
  detected   Json     // servicios, procesos, programas, bases, carpetas, puertos
  metrics    Json?
  sql        Json?
  lastSeenAt DateTime @default(now())

  @@unique([serverId, appKey])
  @@map("app_instances")
}

model AppSample {
  id           String   @id @default(uuid())
  serverId     String
  appKey       String
  at           DateTime @default(now())
  cpu          Float?
  memMb        Float?
  latencyMs    Float?
  latencyMax   Float?
  sqlMs        Float?
  blocked      Int?
  servicesDown Int      @default(0)
  restarts     Int      @default(0)

  @@index([serverId, appKey, at])
  @@index([at])
  @@map("app_samples")
}

model ProbeStat {
  id       String   @id @default(uuid())
  serverId String
  probeKey String
  label    String
  category String   // SMB | AD | APP
  kind     String
  target   String?
  at       DateTime @default(now())
  samples  Int
  failures Int
  slow     Int
  avgMs    Float?
  maxMs    Float?
  p95Ms    Float?

  @@index([serverId, probeKey, at])
  @@index([category, at])
  @@index([at])
  @@map("probe_stats")
}

model MicroOutage {
  id              String    @id @default(uuid())
  serverId        String    // servidor que lo detecto (origen de la medicion)
  probeKey        String
  label           String
  category        String    // SMB | AD | APP
  cause           String
  target          String?
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?

  @@unique([serverId, probeKey, startedAt])
  @@index([startedAt])
  @@index([category, startedAt])
  @@map("micro_outages")
}

// ---------------------------------------------------------------------------
// Guardian de red (services/netGuard.js)
// ---------------------------------------------------------------------------

// Cada MAC que aparecio alguna vez en la red (DHCP, ARP del barrido, UniFi).
model NetDevice {
  mac         String   @id
  ip          String?
  hostname    String?
  vendor      String?
  source      String?  // dhcp | arp | unifi
  randomized  Boolean  @default(false)
  approved    Boolean  @default(false)
  note        String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([ip])
  @@index([firstSeenAt])
  @@map("net_devices")
}

// MAC del gateway vista por cada agente (una fila por servidor).
model NetGatewayState {
  serverId     String   @id
  gatewayIp    String
  baselineMac  String?
  currentMac   String?
  history      Json?    // [{mac, at}] ultimos cambios
  changedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("net_gateway_state")
}

// Servidores DHCP que respondieron a la sonda de cada agente.
model DhcpOffer {
  id          String   @id @default(uuid())
  serverId    String
  dhcpServer  String
  mac         String?
  router      String?
  offeredIp   String?
  dns         String[] @default([])
  authorized  Boolean  @default(true)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([serverId, dhcpServer])
  @@map("dhcp_offers")
}

// Prueba de velocidad programada por sede (una IP publica = una sede).
model SpeedTest {
  id           String   @id @default(uuid())
  serverId     String
  serverName   String
  publicIp     String?
  ok           Boolean  @default(true)
  error        String?
  downloadMbps Float?
  uploadMbps   Float?
  latencyMs    Float?
  jitterMs     Float?
  packetLoss   Float?
  // Speedtest by Ookla (o Cloudflare de respaldo): servidor de prueba, ISP
  // y enlace al resultado publico (evidencia para el reclamo).
  provider     String?
  isp          String?
  testServer   String?
  resultUrl    String?
  contractedDownMbps Float?
  contractedUpMbps   Float?
  manual       Boolean  @default(false)
  at           DateTime @default(now())

  @@index([serverId, at])
  @@index([at])
  @@map("speed_tests")
}

// ---------------------------------------------------------------------------
// Tickets, base de conocimiento y remediaciones
// ---------------------------------------------------------------------------
model Ticket {
  id              String          @id @default(uuid())
  number          Int             @unique @default(autoincrement())
  title           String
  description     String?
  status          String          @default("OPEN") // OPEN | IN_PROGRESS | WAITING | RESOLVED | CLOSED
  priority        String          @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  eventId         String?
  eventType       String?
  serverId        String?
  serverName      String?
  assigneeId      String?
  assigneeName    String?
  createdById     String
  createdByName   String
  resolution      String?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  comments        TicketComment[]

  @@index([status, createdAt])
  @@index([assigneeId, status])
  @@index([eventId])
  @@map("tickets")
}

model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String
  kind      String   @default("comment") // comment | status | assign | system | action
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

model KnowledgeArticle {
  id             String   @id @default(uuid())
  title          String
  problem        String
  solution       String
  tags           String[] @default([])
  alertType      String?
  sourceTicketId String?
  createdByName  String
  uses           Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([alertType])
  @@map("knowledge_articles")
}

// Accion de remediacion aprobada con PIN; la ejecuta el agente del servidor.
model RemediationAction {
  id              String    @id @default(uuid())
  serverId        String
  serverName      String
  eventId         String?
  ticketId        String?
  action          String
  params          Json?
  status          String    @default("PENDING") // PENDING | SENT | SUCCESS | FAILED | EXPIRED
  requestedById   String
  requestedByName String
  output          String?
  createdAt       DateTime  @default(now())
  sentAt          DateTime?
  finishedAt      DateTime?

  @@index([serverId, status])
  @@index([createdAt])
  @@map("remediation_actions")
}

// Fabricantes resueltos en linea (maclookup.app) para prefijos que la IEEE
// no publica; prefijo hexadecimal de 6, 7, 9 o 12 caracteres.
model MacVendorCache {
  prefix    String   @id
  vendor    String?
  address   String?
  country   String?
  block     String?
  source    String?
  updatedAt DateTime @default(now())

  @@map("mac_vendor_cache")
}

// Foto propia de un servidor (Parque de servidores). Aparte para no cargarla
// en cada consulta de la lista de servidores.
model ServerPhoto {
  serverId  String   @id
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt

  @@map("server_photos")
}
