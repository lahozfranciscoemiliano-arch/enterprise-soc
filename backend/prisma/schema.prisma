generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum ServerStatus {
  ONLINE
  OFFLINE
  DEGRADED
}

enum EventType {
  CPU_THRESHOLD
  MEMORY_THRESHOLD
  DISK_THRESHOLD
  LOGIN_FAILURE
  UNAUTHORIZED_ACCESS
  MALWARE_DETECTED
  PORT_SCAN
  BACKUP_FAILED
  BACKUP_WARNING
  CUSTOM
}

enum BackupResult {
  SUCCESS
  WARNING
  FAILED
  NOT_CONFIGURED
  UNKNOWN
}

enum EventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EventStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum FortiIngestMethod {
  API
  SYSLOG
}

enum FortiEventType {
  VPN_LOGIN
  VPN_LOGOUT
  ADMIN_LOGIN
  CONFIG_CHANGE
  IPS_ATTACK
  VIRUS_DETECTED
  INTERFACE_DOWN
  HA_FAILOVER
  TRAFFIC_ANOMALY
  FIREWALL_DENY
  OTHER
}

enum RemoteSessionStatus {
  PENDING
  ACTIVE
  CLOSED
  EXPIRED
  FAILED
}

model User {
  id                   String          @id @default(uuid())
  email                String          @unique
  passwordHash         String
  name                 String
  role                 Role            @default(VIEWER)
  twoFactorEnabled     Boolean         @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[]        @default([])
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  acknowledgedEvents   SecurityEvent[] @relation("AcknowledgedBy")
  auditLogs            AuditLog[]
  sessions             Session[]
  remoteSessions       RemoteSession[]
  assistantLogs        AssistantLog[]

  @@map("users")
}

// Configuracion editable en caliente desde Admin -> Configuracion (SMTP,
// Slack, umbrales por defecto, secretos de integraciones, etc.) sin tener
// que tocar variables de entorno ni reiniciar el contenedor. Los valores
// sensibles (contraseñas, tokens, API keys) se guardan igual que cualquier
// otro pero nunca se devuelven en texto plano por la API (ver settings.js).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model FortiDevice {
  id         String            @id @default(uuid())
  name       String            @unique
  host       String
  apiKeyHash String
  method     FortiIngestMethod @default(API)
  lastSeenAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  events     FortiEvent[]

  @@map("forti_devices")
}

model FortiEvent {
  id          String         @id @default(uuid())
  deviceId    String
  device      FortiDevice    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type        FortiEventType
  severity    EventSeverity
  description String
  sourceIp    String?
  destIp      String?
  raw         Json?
  createdAt   DateTime       @default(now())

  @@index([deviceId, createdAt])
  @@index([severity, createdAt])
  @@map("forti_events")
}

// Sesion de acceso remoto (tunel inverso RDP/VNC/lo que este escuchando en
// targetPort). El agente nunca abre puertos entrantes: se conecta el mismo
// hacia el backend cuando se le pide, y el backend solo re-envia bytes en
// crudo entre esa conexion y la del operador (ver services/remoteBroker.js).
model RemoteSession {
  id         String              @id @default(uuid())
  serverId   String
  server     Server              @relation(fields: [serverId], references: [id], onDelete: Cascade)
  // Nullable + SetNull (no Cascade): quien pidio un acceso remoto a un
  // servidor es informacion de auditoria sensible -- si esa cuenta se borra
  // despues, el registro de que existio esa sesion tiene que sobrevivir,
  // igual que en AuditLog.
  userId     String?
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  targetPort Int                 @default(3389)
  status     RemoteSessionStatus @default(PENDING)
  tokenHash  String
  createdAt  DateTime            @default(now())
  startedAt  DateTime?
  endedAt    DateTime?
  expiresAt  DateTime

  @@index([serverId, createdAt])
  @@map("remote_sessions")
}

// Log de auditoria de lo consultado al asistente (Claude) -- no es un
// historial de conversacion completo, es rastreo de uso/costos y para poder
// revisar despues que se le pregunto sobre datos de la empresa.
model AssistantLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    String
  response  String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("assistant_logs")
}

// Sesiones activas emitidas en el login. El JWT por si solo es stateless
// (no se puede invalidar antes de que expire); esta tabla es lo que permite
// una revocacion real: logout, "cerrar todas mis sesiones", o un admin
// forzando el cierre de sesion de otro usuario (cuenta comprometida, baja).
model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti       String    @unique
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Server {
  id         String          @id @default(uuid())
  name       String          @unique
  hostname   String
  ipAddress  String
  apiKeyHash String
  status     ServerStatus    @default(OFFLINE)
  lastSeenAt DateTime?
  agentVersion String?

  // Etiquetas libres para agrupar servidores (sucursal, ambiente, rol, etc.)
  tags String[] @default([])

  // Umbrales de alerta propios de este servidor; si son null se usan los
  // valores globales por defecto definidos en alertEngine.js.
  cpuThresholdHigh    Float?
  cpuThresholdMedium  Float?
  memThresholdHigh    Float?
  memThresholdMedium  Float?
  diskThresholdHigh   Float?
  diskThresholdMedium Float?

  // Mientras maintenanceUntil este en el futuro, la telemetria/backups de
  // este servidor se siguen guardando normalmente pero no generan alertas.
  maintenanceUntil DateTime?

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  telemetry Telemetry[]
  events    SecurityEvent[]
  backups   BackupStatus[]
  remoteSessions RemoteSession[]

  @@map("servers")
}

model Telemetry {
  id           String   @id @default(uuid())
  serverId     String
  server       Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  cpuUsage     Float
  memoryUsage  Float
  diskUsage    Float
  networkIn    Float?
  networkOut   Float?
  processCount Int?
  metadata     Json?
  recordedAt   DateTime @default(now())

  @@index([serverId, recordedAt])
  @@map("telemetry")
}

model BackupStatus {
  id           String       @id @default(uuid())
  serverId     String
  server       Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  result       BackupResult
  method       String
  lastBackupAt DateTime?
  targetPath   String?
  sizeBytes    Float?
  vssServiceOk Boolean      @default(false)
  detail       String?
  metadata     Json?
  recordedAt   DateTime     @default(now())

  @@index([serverId, recordedAt])
  @@map("backup_status")
}

model SecurityEvent {
  id               String        @id @default(uuid())
  serverId         String
  server           Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  type             EventType
  severity         EventSeverity
  status           EventStatus   @default(OPEN)
  description      String
  sourceIp         String?
  metadata         Json?
  acknowledgedById String?
  acknowledgedBy   User?         @relation("AcknowledgedBy", fields: [acknowledgedById], references: [id])
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?

  @@index([serverId, createdAt])
  @@index([severity, status])
  @@map("security_events")
}
