[Unit]
Description=Enterprise SOC - Backend (Node/Express)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=socapp
WorkingDirectory=/home/socapp/enterprise-soc/backend
EnvironmentFile=/home/socapp/enterprise-soc/backend/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
