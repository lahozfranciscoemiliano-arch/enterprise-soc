# FortiGate: System -> Administrators -> Create New -> REST API Admin
FORTIGATE_HOST=192.168.10.1
FORTIGATE_API_TOKEN=
FORTIGATE_VDOM=root
FORTIGATE_VERIFY_TLS=false
# Si tu FortiGate solo guarda logs en memoria (no en disco), cambia a "memory"
FORTIGATE_LOG_LOCATION=disk

# SOC: Admin -> Fortinet -> "+ Nuevo dispositivo"
SOC_BACKEND_URL=https://bistro.enterprisesoc.lat
FORTI_DEVICE_ID=
FORTI_API_KEY=

POLL_INTERVAL_SECONDS=60
ROWS_PER_POLL=200
# Volumen muy alto, deshabilitado por defecto -- activalo solo si de verdad
# queres cada deny de trafico como evento (no solo los ataques/IPS/virus).
FORWARD_TRAFFIC_DENY=false
