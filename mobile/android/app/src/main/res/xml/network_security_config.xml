<?xml version="1.0" encoding="utf-8"?>
<!-- El NOC se usa por su dominio con HTTPS (https://bistro.enterprisesoc.lat).
     Se sigue permitiendo http solo para poder entrar por la IP de la VPS en
     una emergencia (por ejemplo, un problema de DNS). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
